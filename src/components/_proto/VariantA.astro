	.pa {
		display: flex;
		flex-direction: column;
		gap: var(--sp-sm);
	}

	.pa-name {
		font-size: var(--fs-4);
		line-height: var(--lh-4);
		letter-spacing: var(--ls-display);
		font-weight: 400;
		margin: 0;
	}

	.pa-tagline {
		margin: 0;
		color: var(--color-text-muted);
	}

	.pa-card {
		margin-top: var(--sp-lg);
		display: flex;
		flex-direction: column;
		gap: var(--sp-md);
	}

	/* 問句是這一屏真正的主角，所以它拿階 2，比圖還先被讀到。 */
	.pa-ask {
		margin: 0;
		font-size: var(--fs-2);
		line-height: var(--lh-2);
		max-width: 34em;
	}

	.pa-shot {
		margin: 0;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		overflow: hidden;
		max-height: 300px;
	}

	.pa-shot img {
		display: block;
		width: 100%;
		height: auto;
	}

	.pa-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-sm);
	}

	.pa-note {
		margin: 0;
		color: var(--color-text-muted);
	}

	.pa-exit {
		white-space: nowrap;
	}

	.pa-links {
		margin: var(--sp-lg) 0 0;
