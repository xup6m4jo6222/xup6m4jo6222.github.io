---
/**
 * 全站背景設計（視覺第 9 版，票 02／03）。
 *
 * 兩種模式共用同一支繪製程式：
 *   breathe — 首頁。散點＋一條不動的趨勢線；點各自漂移，全域在散→聚→散之間循環。
 *   reading — 閱讀頁。沒有趨勢線、沒有自發動態，磚頭式無縫平舖，跟著頁面捲動。
 *
 * **值一律由屬性帶進來，這支程式裡不寫值**（SPEC-background-and-homepage
 * 「背景設計參數的判準與檔位」）。`data-motif` 是票 01 定的產物端契約：內容必須等於
 * 判準檔的 `MOTIF`，閘門第七類就是照它驗的。技法常數走 `data-motif-craft`。
 *
 * canvas 是**純加法**：移除它之後頁面回到現行的三層背景，版面不受影響。
 * 沒有 JavaScript 時就是那個狀態，不需要另外寫退路。
 */
import { MOTIF, MOTIF_CRAFT } from '../../scripts/palette-config.mjs';

interface Props {
	mode: 'breathe' | 'reading';
}

const { mode } = Astro.props;
---

<canvas
	class="motif"
	aria-hidden="true"
	data-motif={JSON.stringify(MOTIF)}
	data-motif-craft={JSON.stringify(MOTIF_CRAFT)}
	data-motif-mode={mode}></canvas>

<style>
	/* z 層級用既有的 −1（與顆粒層同層）。canvas 在 body::before 之後，
	   所以背景設計畫在顆粒之上、內容之下——內容一律在 z-index auto 的常規流裡。 */
	.motif {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
	}
</style>

<script>
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');

	/** 目前這一頁的收工函式（換頁與偏好改變時呼叫），沒有背景設計時是 null。 */
	let teardown: (() => void) | null = null;
	/** 已經啟動過的那個 canvas。換頁時 ClientRouter 會換掉整個元素，所以比對元素本身。 */
	let running: HTMLCanvasElement | null = null;

	function start() {
		const cv = document.querySelector<HTMLCanvasElement>('canvas.motif');
		const main = document.querySelector('main');
		/* 首次載入時這支程式會被叫兩次（模組自己叫一次、ClientRouter 的 astro:page-load
		   再叫一次）。不擋掉的話點會重擲一輪——實測就是讀者在 100ms 時看到背景整片換掉，
		   那等於一次自發動態。 */
		if (cv && cv === running) return;
		teardown?.();
		teardown = null;
		running = cv;
		if (!cv || !main || !cv.dataset.motif || !cv.dataset.motifCraft) return;

		const M = JSON.parse(cv.dataset.motif);
		const K = JSON.parse(cv.dataset.motifCraft);
		const L = K.layout;
		const breathing = cv.dataset.motifMode === 'breathe';
		const ctx = cv.getContext('2d', { alpha: true });
		if (!ctx) return;

		/** 色只從判準值來；不透明度接在後面，所以這支程式裡沒有任何色碼字面值。 */
		const withAlpha = (hex: string, a: number) =>
			hex +
			Math.round(Math.min(1, Math.max(0, a)) * 255)
				.toString(16)
				.padStart(2, '0');

		/* ── 離散度：點的分布與線的實度共用這一個函式 ──────────────────────
		   兩處各寫一組數字必然不同步，那正是「趨勢線讀起來像裝飾框線」的成因。

		   實度是「相對於最散那一端收斂了多少」。**不要正規化成 0–1**——
		   第一版寫成 (spread(0)−spread(u))/(spread(0)−spread(1))，代數上恆等於 u，
		   `spreadEnds` 被整個約掉：點散得再開，線也照樣畫到全實。那是形式上共用、
		   實際上沒接上。現在端點比 3.83 直接決定線最實處只到 0.739。 */
		const spreadAt = (u: number) => M.spreadEnds[0] + (M.spreadEnds[1] - M.spreadEnds[0]) * u;
		const solidity = (u: number) => 1 - spreadAt(u) / spreadAt(0);

		// 指數成長：終點斜率是起點的 trendSlopeRatio 倍 → k = ln(ratio)
		const k = Math.log(M.trendSlopeRatio);
		const expT = (u: number) => (Math.exp(k * u) - 1) / (Math.exp(k) - 1);

		/* 背景設計走向上的座標。**只有這一份**——點的位置與線的位置各寫一份的話，
		   哪天改了構圖常數就會分家，那正是「共用同一個離散度函式」在防的同一件事。
		   （W／viewH 是 let，所以寫成函式而不是在 resize 時算好。） */
		const px = (u: number) => W * (L.xInset + u * (1 - 2 * L.xInset));
		const trendY = (u: number) => layoutH * (L.trendBand[0] + (L.trendBand[1] - L.trendBand[0]) * expT(u));

		/** 等距的漸層節點：判準檔給幾個顏色就分幾段，位置不另外寫一組數字。 */
		const evenStops = (n: number) => Array.from({ length: n }, (_, i) => i / (n - 1));

		/**
		 * 呼吸曲線：三個週期比為 φ² 的正弦相加，權重比同樣是 φ²。
		 * φ 最難被有理數逼近，所以合成回到同一個畫面的時間最長——
		 * 「動畫不是固定的」靠週期不可通約成立，不是靠每幀重擲亂數（那會抖）。
		 * 權重和為 1，故回傳值落在 0（最散）–1（最聚），t=0 時剛好是中點。
		 */
		const periods = [M.breathPeriod, M.breathPeriod / M.breathRatio, M.breathPeriod * M.breathRatio];
		const breath = (t: number) =>
			(M.breathWeights.reduce(
				(s: number, w: number, i: number) => s + w * Math.sin((2 * Math.PI * t) / periods[i]),
				0,
			) +
				1) /
			2;

		let W = 0;
		let viewH = 0;
		/** 構圖高度。**不是**即時視窗高——手機的視窗高會隨網址列收合而跳動，
		    整個構圖（點、趨勢線、漸層、遠景層）一律錨在這個值上，才不會拆成兩半。 */
		let layoutH = 0;
		/** 遠景層要涵蓋到的高度＝構圖高加上容忍幅度，視窗在容忍帶內長高時才不會露邊。 */
		const farH = () => layoutH * (1 + L.heightTolerance);
		let DPR = 1;
		let col = 0;
		let tile = 0;
		let pts: any[] = [];
		/** 遠景層連同它建立時用的高度一起存——貼圖時讀這個值，不要再算一次。
		    兩處各算一次「必須一致」，靠的是 resize() 在構圖高改變時把它清成 null
		    這條隱性不變量；日後改 reshape 判斷時漏改，遠景層就會被貼歪。 */
		let farLayer: { c: HTMLCanvasElement; h: number } | null = null;
		let bandMask: HTMLCanvasElement | null = null;
		let bandTop = 0;
		let tint: CanvasGradient | null = null;
		let fade: CanvasGradient | null = null;
		let raf = 0;
		let queued = false;

		/** 預繪的柔邊光點。每幀替幾百個點各畫一次徑向漸層會很燙，這一步是為了讓它涼。
		    顏色在這裡無關緊要——整團點稍後由 source-in 重新上色，這張圖只提供不透明度。 */
		function makeSprite() {
			const S = K.spriteSize;
			const c = document.createElement('canvas');
			c.width = S;
			c.height = S;
			const g = c.getContext('2d')!;
			const rg = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
			rg.addColorStop(0, withAlpha(M.gradient[1], 1));
			rg.addColorStop(L.spriteMid[0], withAlpha(M.gradient[1], L.spriteMid[1]));
			rg.addColorStop(1, withAlpha(M.gradient[1], 0));
			g.fillStyle = rg;
			g.fillRect(0, 0, S, S);
			return c;
		}
		const sprite = makeSprite();

		const blit = (p: any, x: number, y: number) => {
			ctx.globalAlpha = p.a;
			ctx.drawImage(sprite, x - p.r, y - p.r, p.r * 2, p.r * 2);
		};

		/** 每千平方像素幾個點——不是絕對數量，不同裝置上密度才會一樣。 */
		const countFor = (area: number, density: number) =>
			Math.min(K.pointCap, Math.round((area / 1000) * density));

		// ── 首頁：散開位置、聚攏位置、各自的漂移 ──────────────────────────
		function buildBreathe() {
			pts = [];
			const n = countFor(W * layoutH, M.density.home);
			for (let i = 0; i < n; i++) {
				const u = Math.random();
				const layer = i % M.depthRadius.length; // 景深各層平分
				const outlier = Math.random() < M.outlierRatio;
				// 往上（冒險成功）：往下（冒險失敗）＝ 3：1。往上的會出現在姓名那一帶。
				const dir = Math.random() < M.outlierUpRatio ? -1 : 1;
				const off = outlier
					? dir * (L.outlierOffset[0] + Math.random() * (L.outlierOffset[1] - L.outlierOffset[0]))
					: Math.random() * 2 - 1;
				const scatter = off * spreadAt(u) * layoutH * L.scatterHeight;
				// 行程（散開位置→聚攏位置）。離群值收得少，呼吸時不會被收回去。
				// 走不到整段行程的點就走到趨勢線為止，不會穿過去——實際行程只會更短，
				// 所以紅線③ 的上界照樣成立。
				const travel = outlier ? M.travel.outlier : M.travel.normal;
				pts.push({
					x: px(u),
					base: trendY(u) + scatter,
					pull: Math.sign(scatter) * Math.min(travel, Math.abs(scatter)),
					r: M.depthRadius[layer],
					a: M.depthAlpha[layer],
					far: layer === 0, // 遠景固定：模糊靠大半徑的柔邊光點，不每幀重算
					// 呼吸曲線上的時間偏移。範圍只有一個週期的 1/8——**錯開不是打散**：
					// 整團仍要一起散→聚→散，偏移大了整團的呼吸就被平均掉了（見判準檔）。
					t0: Math.random() * M.breathPeriod * L.breathDesync,
					// 每組漂移的起始相位各自隨機——組數由判準檔的振幅表決定，不另外寫一個 3
					px3: M.driftAmplitude.map(() => Math.random() * 2 * Math.PI),
					py3: M.driftAmplitude.map(() => Math.random() * 2 * Math.PI),
				});
			}
		}

		// ── 閱讀頁：一塊磚裡的點。磚頭首尾同源，接縫在數學上不存在 ────────
		function buildReading() {
			const box = main!.getBoundingClientRect();
			const centre = (box.left + box.width / 2) / W;
			const half = box.width / 2 / W; // 淨空半徑＝欄寬的一半
			pts = [];
			const n = countFor(W * tile, M.density.reading);
			for (let i = 0; i < n; i++) {
				const x = Math.random();
				// 離中線越近越容易被丟掉：正文在中間，背景讓開
				const near = 1 - Math.min(1, Math.abs(x - centre) / half);
				if (Math.random() < near * (1 - M.readingKeepRatio)) continue;
				const layer = i % M.depthRadius.length;
				pts.push({
					x,
					y: Math.random() * tile,
					r: M.depthRadius[layer],
					a: M.depthAlpha[layer],
				});
			}
		}

		type Box = { top: number; bottom: number; left: number; right: number };
		const union = (a: Box | null, r: DOMRect): Box =>
			a
				? {
						top: Math.min(a.top, r.top),
						bottom: Math.max(a.bottom, r.bottom),
						left: Math.min(a.left, r.left),
						right: Math.max(a.right, r.right),
					}
				: { top: r.top, bottom: r.bottom, left: r.left, right: r.right };

		/**
		 * 文字可能出現的區域（文件座標）。
		 *
		 * main 取各個子元素的聯集而不是 main 自己的盒子：首頁的 main 撐滿一屏（flex:1），
		 * 拿它當文字帶等於把下半整片一起減光，而那格空白正是背景設計的位置。
		 * **頁尾要各算一塊**：它在 main 外面、底又是透明的，第一次實測就是一顆點落在
		 * 「© 2026」後面，muted 掉到 4.70——只差 0.2 就違規。導覽列不必：它自己有 92% 的底。
		 */
		function contentBoxes() {
			const boxes: Box[] = [];
			let inner: Box | null = null;
			for (const el of Array.from(main!.children)) {
				const r = el.getBoundingClientRect();
				if (r.width && r.height) inner = union(inner, r);
			}
			if (inner) boxes.push(inner);
			const foot = document.querySelector('footer');
			if (foot) {
				const r = foot.getBoundingClientRect();
				// 頁尾橫跨整頁寬，但字只在欄裡——取欄寬，否則整條底邊都被減光
				if (r.width && r.height) {
					const half = col / 2;
					const cx = main!.getBoundingClientRect().left + half;
					boxes.push({ top: r.top, bottom: r.bottom, left: cx - half, right: cx + half });
				}
			}
			return boxes.map((b) => ({ ...b, top: b.top + scrollY, bottom: b.bottom + scrollY }));
		}

		/**
		 * 文字帶的減光遮罩。背景設計在文字可能出現的區域內，合成後的不透明度封頂在
		 * `textBandMaxAlpha`（＝既有藍暈峰值）——元素主色對內文只有 2.39 的對比，
		 * 一顆近景光點落在姓名後面就會讓那一帶掉到門檻以下。
		 * **點還在，只是在文字帶內淡下來**：本人指定的是離群值的位置，不是亮度。
		 *
		 * 每一塊用可分離的兩道 ramp（水平 × 垂直）做，不是模糊——邊緣化開的寬度才算得準，
		 * 而且不必每次重建都跑一次濾鏡。
		 *
		 * **多塊先疊成「覆蓋率」再一次乘上減光量，不是每塊各自帶著減光量疊。**
		 * 後者在閱讀頁會出事：main 與頁尾兩塊的左右邊界幾乎相同，兩份 0.9 疊起來夾成 1.0，
		 * `destination-out` 就把正文欄整條挖光——上限變成全清，`readingKeepRatio` 也跟著成了死參數。
		 * code review 抓到、瀏覽器實測確認（欄內非零像素 0 個）。
		 */
		function makeBandMask(boxes: Box[]) {
			const sized = () => {
				const c = document.createElement('canvas');
				c.width = cv!.width;
				c.height = cv!.height;
				const g2 = c.getContext('2d')!;
				g2.setTransform(DPR, 0, 0, DPR, 0, 0);
				return [c, g2] as const;
			};
			const [m, g] = sized();
			const [coverage, cover] = sized();
			const [scratch, s] = sized();
			const fw = col * L.textBandFeather;

			/** 一道兩側化開的 ramp：外緣 0、內側整段滿。 */
			const ramp = (a: number, b: number, vertical: boolean) => {
				const grad = vertical
					? s.createLinearGradient(0, a - fw, 0, b + fw)
					: s.createLinearGradient(a - fw, 0, b + fw, 0);
				const stop = fw / Math.max(1, b - a + 2 * fw);
				grad.addColorStop(0, withAlpha(M.gradient[0], 0));
				grad.addColorStop(stop, withAlpha(M.gradient[0], 1));
				grad.addColorStop(1 - stop, withAlpha(M.gradient[0], 1));
				grad.addColorStop(1, withAlpha(M.gradient[0], 0));
				return grad;
			};

			for (const box of boxes) {
				s.globalCompositeOperation = 'source-over';
				s.clearRect(0, 0, W, viewH);
				s.fillStyle = ramp(box.left, box.right, false);
				s.fillRect(0, 0, W, viewH);
				// 閱讀頁的正文欄貫穿整頁，垂直方向不收；首頁的文字只佔一塊，要收。
				if (breathing) {
					s.globalCompositeOperation = 'destination-in';
					s.fillStyle = ramp(box.top - scrollY, box.bottom - scrollY, true);
					s.fillRect(0, 0, W, viewH);
				}
				cover.drawImage(scratch, 0, 0, W, viewH);
			}
			// 覆蓋率 × 減光量：挖掉這麼多，剩下的就是上限 textBandMaxAlpha
			g.globalAlpha = 1 - M.textBandMaxAlpha;
			g.drawImage(coverage, 0, 0, W, viewH);
			bandTop = scrollY;
			return m;
		}

		let shape = '';
		function resize() {
			DPR = Math.min(window.devicePixelRatio || 1, K.dprCap);
			W = window.innerWidth;
			viewH = window.innerHeight;
			col = main!.getBoundingClientRect().width;
			// 版面還沒算出來（或 main 是空的）就先不畫：ResizeObserver 會在算出來時再叫一次。
			if (!W || !viewH || !col) return;
			/* 點只在「畫布真的變了」時重擲。內文變高（圖載完、字體換上來）會讓
			   ResizeObserver 叫這裡，但那些跟畫布無關——每次都重擲的話，讀者會看到
			   背景在讀到一半時整片換掉，那就成了自發動態。實測抓到的就是這一個。

			   **視窗高不能原樣進簽章**（2026-07-28 抗辯第一輪紅隊提出、真 iPhone 實測確認）：
			   手機捲動時網址列收合會讓 `innerHeight` 真的變動數十 px（本站實測同一台
			   iPhone 上首頁 684、閱讀頁 744），舊寫法一變就重擲，讀者每次上下滑都看到
			   背景整片重洗——與上面那一段要防的是同一個症狀，只是來源不是 ResizeObserver
			   的假警報，而是真的 resize 事件。無頭環境驗不出來（resize 送不進去），
			   所以它一路活到發佈前才被抓到。

			   閱讀頁的點**完全不吃 viewH**（位置只有 x 比例與磚內 y，磚高綁欄寬），所以直接不看；
			   首頁的點吃 viewH（散開半幅與趨勢線高度都乘 viewH），但網址列那種幅度（約一成）
			   不值得重擲。真正需要重擲的是換裝置或轉向，而那必然連 W 也一起變。 */
			const now = `${W}@${DPR}／${Math.round(col)}`;
			/* 構圖高度 layoutH 只在版面真的變了時才跟上。第一版修法是「點不重擲、但別的照舊」，
			   抗辯第二輪三個鏡頭一致抓到那樣會把構圖拆成兩半：趨勢線與漸層每次都用即時 viewH
			   重算，點卻凍在舊 viewH，於是「點收斂到趨勢線」這個核心視覺會錯位；遠景層更慘，
			   它是照建立當時的畫布尺寸做的一張圖，畫的時候被拉伸成新高度。
			   正解是把**整個構圖**錨在同一個高度上，而不是只凍住其中一半。 */
			const heightMoved = Math.abs(viewH - layoutH) > layoutH * L.heightTolerance;
			if (heightMoved) layoutH = viewH;
			// 點要不要重擲：閱讀頁的點不吃構圖高（位置只有 x 比例與磚內 y），首頁的吃
			const reshape = now !== shape || (breathing && heightMoved);
			shape = now;
			tile = col * M.tileHeightColumns; // 磚高＝欄寬 × 2，綁 --max-width
			cv!.width = Math.round(W * DPR);
			cv!.height = Math.round(viewH * DPR);
			ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);

			// 漸層跟著確定性走：最散亂的一端最灰、最收斂的一端最亮（亮端封頂中性階 700）
			tint = ctx!.createLinearGradient(0, layoutH, W, 0);
			evenStops(M.gradient.length).forEach((at, i) => tint!.addColorStop(at, M.gradient[i]));

			const cx = W * L.fadeCenter[0];
			const cy = layoutH * L.fadeCenter[1];
			fade = ctx!.createRadialGradient(cx, cy, 0, cx, cy, Math.max(W, layoutH));
			evenStops(L.fadeStops.length).forEach((at, i) =>
				fade!.addColorStop(at, withAlpha(M.gradient[0], L.fadeStops[i])),
			);

			if (reshape) {
				if (breathing) buildBreathe();
				else buildReading();
				farLayer = null;
			}
			const boxes = contentBoxes();
			bandMask = boxes.length ? makeBandMask(boxes) : null;
			draw(0);
		}

		/** 遠景固定，不參與動畫——它只畫一次，之後每幀貼上去。 */
		function makeFarLayer(): { c: HTMLCanvasElement; h: number } {
			const m = document.createElement('canvas');
			/* 尺寸綁構圖高而不是當下的畫布高：畫布會隨視窗高跳動，遠景層不會。
			   兩者脫鉤時 drawImage 會把整張圖拉伸（抗辯第二輪實測到的那條）。

			   高度要多留一個容忍幅度：視窗高在容忍帶內長高時（網址列收合），畫布跟著長，
			   但構圖不動——遠景層若只畫到 layoutH，底部就會露出一條沒有遠景的空白帶
			   （抗辯第三輪拍圖確認，17% 差距時肉眼可辨）。近景點與趨勢線本來就會自然
			   溢出 layoutH，只有這張預繪圖有硬邊界，所以補在這裡就夠。 */
			m.width = Math.round(W * DPR);
			m.height = Math.round(farH() * DPR);
			const g = m.getContext('2d')!;
			g.setTransform(DPR, 0, 0, DPR, 0, 0);
			const g0 = breath(0);
			for (const p of pts) {
				if (!p.far) continue;
				g.globalAlpha = p.a;
				const y = p.base - p.pull * g0;
				g.drawImage(sprite, p.x - p.r, y - p.r, p.r * 2, p.r * 2);
			}
			return { c: m, h: farH() };
		}

		function draw(sec: number) {
			ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
			ctx!.clearRect(0, 0, W, viewH);
			ctx!.globalCompositeOperation = 'source-over';

			if (breathing) {
				if (!farLayer) farLayer = makeFarLayer();
				ctx!.globalAlpha = 1;
				ctx!.drawImage(farLayer.c, 0, 0, W, farLayer.h);
				const frozen = still.matches;
				for (const p of pts) {
					if (p.far) continue;
					let dx = 0;
					let dy = 0;
					if (!frozen) {
						M.driftAmplitude.forEach((amp: number, i: number) => {
							const w = 2 * Math.PI * M.driftFrequency[i] * sec;
							dx += amp * Math.sin(w + p.px3[i]);
							dy += amp * Math.sin(w + p.py3[i]);
						});
					}
					// 每個點在呼吸曲線上取一個時間偏移，整團才不會像一個東西在脈動。
					// 偏移的是時間不是振幅，所以峰值速度與閘門算的上界一致。
					const g = breath(frozen ? 0 : sec + p.t0);
					blit(p, p.x + dx, p.base - p.pull * g + dy);
				}
			} else {
				const sy = scrollY;
				const first = Math.floor(sy / tile) - 1;
				const last = Math.floor((sy + viewH) / tile) + 1;
				for (let t = first; t <= last; t++) {
					const base = t * tile - sy;
					for (const p of pts) {
						const y = base + p.y;
						if (y < -p.r * 2 || y > viewH + p.r * 2) continue;
						blit(p, p.x * W, y);
					}
				}
			}

			// 整團點是同一張圖，這一步把顏色蓋上去
			ctx!.globalAlpha = 1;
			ctx!.globalCompositeOperation = 'source-in';
			ctx!.fillStyle = tint!;
			ctx!.fillRect(0, 0, W, viewH);
			ctx!.globalCompositeOperation = 'source-over';

			// 趨勢線：位置固定、指數成長，實度由點的離散程度決定。
			// 左段點散得開則線幾乎不存在，越往右越收斂則線越實，右端自己收尾——
			// 外推的地方沒有資料，本來就不該畫實線。閱讀頁沒有這條線。
			if (breathing) {
				ctx!.strokeStyle = tint!;
				ctx!.lineCap = 'round';
				ctx!.lineWidth = M.trendLineWidth;
				const seg = K.trendSegments;
				for (let i = 0; i < seg; i++) {
					const u0 = i / seg;
					const u1 = (i + 1) / seg;
					const um = (u0 + u1) / 2;
					const w = solidity(um) * Math.min(1, (1 - um) / L.trendTail);
					if (w <= 0) continue;
					ctx!.globalAlpha = L.trendAlpha * w;
					ctx!.beginPath();
					ctx!.moveTo(px(u0), trendY(u0));
					ctx!.lineTo(px(u1), trendY(u1));
					ctx!.stroke();
				}
			}

			// 四周化開：讓背景設計有重心，不是均勻鋪滿被視窗切斷
			ctx!.globalAlpha = 1;
			ctx!.globalCompositeOperation = 'destination-out';
			ctx!.fillStyle = fade!;
			ctx!.fillRect(0, 0, W, viewH);
			// 文字帶減光。首頁的遮罩隨頁面走（它綁在文字上，不是綁在視窗上）
			if (bandMask) ctx!.drawImage(bandMask, 0, breathing ? bandTop - scrollY : 0, W, viewH);
			ctx!.globalCompositeOperation = 'source-over';
		}

		const t0 = performance.now();
		let last = 0;
		function frame(now: number) {
			raf = requestAnimationFrame(frame);
			if (document.hidden) return; // 分頁不可見時不繪製
			if (now - last < 1000 / M.fpsCap) return; // 幀率上限
			last = now;
			draw((now - t0) / 1000);
		}

		// 閱讀頁沒有常駐迴圈：只在捲動與改變視窗大小時重畫
		function onScroll() {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				draw(0);
			});
		}

		/* main 的盒子會在字體換上來之後改變（`display=fallback` 的那一次交換），
		   文字帶的位置跟著它走，所以觀察的是 main 而不是只聽 window resize。
		   視窗高度變了但 main 沒變（長文頁）的情況由 resize 事件補上，兩個都要。 */
		/* resize 要節流。它每次都重建三張整面離屏畫布（文字帶遮罩）＋兩個漸層，
		   是這支程式最貴的一條路；而拖曳視窗邊框時瀏覽器會連續密集送事件。
		   捲動那條路一開始就有 rAF 節流，這條漏了（抗辯第二輪實測：單次 resize()
		   在 1440×900@DPR2 要 444ms、3440×1440@DPR2 要 1689ms，拖曳時分頁會卡住）。 */
		let sizing = false;
		const onResize = () => {
			if (sizing) return;
			sizing = true;
			requestAnimationFrame(() => {
				sizing = false;
				resize();
			});
		};
		const observer = new ResizeObserver(onResize);
		observer.observe(main);
		window.addEventListener('resize', onResize);
		// 呼吸模式在降低動態偏好下不跑迴圈，但捲動時文字帶要跟著移動，所以照樣聽捲動
		if (!breathing || still.matches) window.addEventListener('scroll', onScroll, { passive: true });

		resize();
		// 降低動態偏好時仍然畫，只是不動——要關的是空間位移，不是把畫面清空
		if (breathing && !still.matches) raf = requestAnimationFrame(frame);

		teardown = () => {
			cancelAnimationFrame(raf);
			observer.disconnect();
			window.removeEventListener('resize', onResize);
			window.removeEventListener('scroll', onScroll);
		};
	}

	document.addEventListener('astro:page-load', start);
	// 偏好改了要真的重來一次（動態的開關在 start 裡決定），所以先把「已啟動」清掉
	still.addEventListener('change', () => {
		running = null;
		start();
	});
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start, { once: true });
	} else {
		start();
	}
</script>
