---
import { t } from '../../text.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DESIGN_CATEGORIES, designCount } from '../../design-items.mjs';

/* 展示櫃目錄（SPEC-design-showcase）：六類，只列有貨的。
   導覽列不加「設計」——它是 AI#1 的內部細節，入口在那一頁（本人拍板）。 */
const cats = DESIGN_CATEGORIES.filter((c) => c.items.some((i) => !i.pending));
---

<BaseLayout
	title={t('site.title_format', { title: t('design.index.title') })}
	backLink={{ href: '/projects/ai/portfolio-site/', label: t('design.index.back') }}
	motif="reading"
>
	<h1>{t('design.index.title')}</h1>
	<p class="category-label">{t('design.index.count', { count: designCount() })}</p>
	<p class="intro">{t('design.index.intro')}</p>

	<div class="cards">
		{
			cats.map((c) => {
				const live = c.items.filter((i) => !i.pending).length;
				return (
					<a class="card" href={`/design/${c.key}/`} data-reveal>
						<span class="card-num" aria-hidden="true">
							{live}
						</span>
						<span class="card-body">
							<h3>{c.label}</h3>
							<p>{c.items.filter((i) => !i.pending).map((i) => i.name.split('：')[0]).join('、')}</p>
						</span>
					</a>
				);
			})
		}
	</div>
</BaseLayout>
