---
import { t } from '../text.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/* 背景設計模式：**暫行值，本人尚未拍板**（docs/SPEC-background-and-homepage 未定二）。
    暫行採呼吸，理由是它跟首頁一樣沒有要讀的長文。日後改動只該是換一個模式。 */}
<BaseLayout title={t('site.title_format', { title: t('notfound.title') })} motif="breathe">
	<h1>404</h1>
	<p class="category-label">{t('notfound.message')}</p>
	<p><a href="/" class="back-link">{t('notfound.back')}</a></p>
</BaseLayout>
